---
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';

const recipes = (await getCollection('recipes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Recipes — Pantry" description="Explore a demo Astro recipe journal: soups, salads, smoothies, and weeknight mains.">
	<main>
		<section class="hero wrap">
			<h1>Recipes</h1>
			<hr class="rule" />
			<blockquote class="quote">
				“A good pot on the stove is how a kitchen earns its keep.”
				<cite>Pantry, demo issue</cite>
			</blockquote>
		</section>
		<div class="wrap">
			<CategoryNav />
			<section class="grid">
				{recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
			</section>
		</div>
	</main>
</Base>
